{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "test:domain": "vitest run --config vitest.domain.config.ts",
    "test:domain:coverage": "vitest run --config vitest.domain.config.ts --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 --report-unused-disable-directives --cache --cache-location .cache/eslint",
    "lint:fix": "eslint . --fix --cache --cache-location .cache/eslint",
    "lint:styles": "stylelint \"src/**/*.css\" --max-warnings=0 --allow-empty-input",
    "lint:styles:fix": "stylelint \"src/**/*.css\" --fix --allow-empty-input",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "arch:report": "npm run reports:init && depcruise src --config .dependency-cruiser.cjs --output-type err-html --output-to reports/architecture.html",
    "arch:graph": "npm run reports:init && depcruise src --config .dependency-cruiser.cjs --output-type mermaid --output-to reports/architecture.mmd",
    "arch:dot": "npm run reports:init && depcruise src --config .dependency-cruiser.cjs --output-type archi --output-to reports/architecture.dot",
    "deadcode": "knip",
    "dupes": "jscpd src",
    "mutation": "stryker run",
    "size": "size-limit",
    "verify:quick": "npm run typecheck && npm run arch && npm run deadcode",
    "verify": "npm run format:check && npm run lint && npm run lint:styles && npm run typecheck && npm run arch && npm run deadcode && npm run dupes && npm run test:ci && npm run build && npm run size",
    "reports:init": "node -e \"require('node:fs').mkdirSync('reports',{recursive:true})\"",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "@phosphor-icons/web": "^2.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@size-limit/file": "^13.0.3",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "angular-eslint": "^22.1.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-rxjs-x": "^1.0.4",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.14",
    "jsdom": "^28.0.0",
    "knip": "^6.32.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.1",
    "size-limit": "^13.0.3",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.0.8"
  }
}
