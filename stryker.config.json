{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing for the pure layers only: checks that domain tests actually assert behaviour instead of just executing it. Run manually or on a schedule, not in pre-push.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.domain.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/app/features/*/domain/**/*.ts",
    "src/app/features/*/application/**/*.ts",
    "src/app/shared/kernel/**/*.ts",
    "!**/*.spec.ts",
    "!**/index.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 70
  },
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
